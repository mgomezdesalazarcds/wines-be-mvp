generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A liquor store / retailer using the app. Each company curates its own
/// listing (price, stock, voice/copy) on top of the shared wine catalog.
model Company {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?  @map("logo_url")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  wines CompanyWine[]
  users User[]

  @@map("companies")
}

/// ADMIN is scoped to one company (edit wines, upload CSVs/photos, and
/// manage that company's own users once that's built). SUPER_ADMIN manages
/// companies and users across the whole system instead, so it isn't scoped
/// to any one company. More granular company-level roles (e.g. an
/// employee who can't manage users) can be added later without another
/// migration touching this shape.
enum Role {
  SUPER_ADMIN
  ADMIN
}

/// A person who can log in. `role` decides what they can do; `companyId` is
/// the tenant check every company-scoped endpoint needs — null for
/// SUPER_ADMIN, required for ADMIN.
model User {
  id           String   @id @default(uuid())
  companyId    String?  @map("company_id")
  role         Role     @default(ADMIN)
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  company     Company?     @relation(fields: [companyId], references: [id])
  inviteToken InviteToken?

  @@index([companyId])
  @@map("users")
}

/// A one-time link letting a newly-created user set their own password
/// instead of the super admin choosing it for them. Created alongside the
/// User (with an unusable random passwordHash placeholder) and deleted the
/// moment it's redeemed — `onDelete: Cascade` also cleans it up if the user
/// is deleted before ever accepting.
model InviteToken {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

/// The generic wine catalog — one row per real-world wine, shared across every
/// company. Not a specific bottle: no vintage here, since the same SKU can be
/// restocked under a different vintage.
///
/// `extraData` is the AI-generated enrichment (tasting_notes, taste_profile,
/// pairs_well_with, variety, region, country, body/acidity/tannin/sweetness,
/// dryness_label, why_we_love_it, from_the_team, provenance) — the default
/// copy every company starts from.
///
/// `isWine`/`section`/`sectionSource` are objective classification facts
/// about the item (is it actually a wine bottle, what country it's from) —
/// same for every company, unlike `staffPick` which is a per-store curation
/// choice and lives on `CompanyWine`. `section` is a plain indexed column
/// (not folded into `extraData`) because search scopes/filters on it
/// directly in raw SQL for performance.
///
/// `size` lives here, not on `CompanyWine`: a 750ml and a 1.5L magnum of the
/// same label are different products (different price, different generic
/// wine), not the same wine presented differently per store. Import-time
/// dedup (matching a new CSV row to an existing Wine) keys on `itemName` +
/// `size` together for this reason.
model Wine {
  id            String   @id @default(uuid())
  itemName      String   @map("item_name")
  size          String?
  isWine        Boolean  @default(false) @map("is_wine")
  section       String?
  sectionSource String   @default("heuristic") @map("section_source")
  extraData     Json?    @map("extra_data")
  createdAt     DateTime @default(now()) @map("created_at")

  companies CompanyWine[]

  @@index([itemName], map: "idx_wines_name")
  @@index([section], map: "idx_wines_section")
  @@map("wines")
}

/// A company's listing of a wine — everything that varies per store.
///
/// `extraData` is null until the company edits their copy; when set, it's
/// the same shape as `Wine.extraData` and takes priority — the API resolves
/// a listing's enrichment as `companyWine.extraData ?? wine.extraData`, so
/// a company only needs to override the fields it actually wants to change.
model CompanyWine {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  wineId        String   @map("wine_id")
  lookupCode    String   @map("lookup_code")
  price         Float
  sale          Float?
  stockCount    Int?     @map("stock_count")
  availability  String?
  staffPick     Boolean  @default(false) @map("staff_pick")
  isLastArrival Boolean  @default(false) @map("is_last_arrival")
  imageUrl      String?  @map("image_url")
  extraData     Json?    @map("extra_data")
  createdAt     DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  wine    Wine    @relation(fields: [wineId], references: [id])

  @@unique([companyId, lookupCode])
  @@index([companyId, staffPick], map: "idx_company_wines_staff")
  @@map("company_wines")
}

model ScanLog {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  status            String
  extractedText     String?  @map("extracted_text")
  matchedLookupCode String?  @map("matched_lookup_code")
  confidence        Float?
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("scan_logs")
}

/// Generic failure log for things that don't have their own table — a scan
/// that errored out before producing a ScanLog, a search with no results.
model FailureLog {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  source    String
  message   String
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, source])
  @@map("failure_logs")
}

/// A lightweight engagement event — the things ScanLog/FailureLog don't
/// already cover (QR visits, wine detail views, Staff Favorites/New
/// Arrivals opens, shelf saves). `type` is a free-form string rather than
/// an enum so the pilot analytics page can add new event types without a
/// migration; `metadata` holds whatever's specific to that type (e.g. the
/// lookup_code for a wine_viewed event).
model AnalyticsEvent {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  type      String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, type])
  @@map("analytics_events")
}

/// A CSV inventory file a company uploaded via the admin import screen — the
/// raw file itself (so it can be downloaded again later), plus a summary of
/// what importCsvForCompany() did with it.
model CsvImport {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  filename     String
  content      String
  totalRows    Int      @map("total_rows")
  createdCount Int      @map("created_count")
  reusedCount  Int      @map("reused_count")
  updatedCount Int      @map("updated_count")
  skippedCount Int      @map("skipped_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("csv_imports")
}
